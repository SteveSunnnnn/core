ui_text hud.tip.treasury   { en = "Treasury|Current national treasury balance" zh_cn = "国库|当前国家财政余额" }
ui_text hud.tip.balance    { en = "Weekly Balance|Projected weekly income after expenses" zh_cn = "每周结余|扣除支出后的预计周收入" }
ui_text hud.tip.population { en = "Population|Total population of the player nation" zh_cn = "人口|玩家国家的总人口" }
ui_text hud.tip.gdp        { en = "Gross Domestic Product|Estimated value of national output" zh_cn = "国内生产总值|国家产出的估算价值" }
ui_text hud.tip.time       { en = "Date and Game Speed|Pause or select simulation speed" zh_cn = "日期与游戏速度|暂停或选择模拟速度" }

