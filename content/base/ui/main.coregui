ui_text showcase.hover          { en = "HOVER" zh_cn = "悬停" }
ui_text showcase.pressed        { en = "PRESSED" zh_cn = "按下" }
ui_text showcase.selected       { en = "SELECTED" zh_cn = "选中" }
