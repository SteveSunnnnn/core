scripted_gui main_hud {
    context = hud
    root = {
        type = column
        id = hud_root
        gap = 0
        children = {
            panel = { id = top_bar_surface style = top height = 82 children = {
                row = { id = top_bar gap = 0 children = {
                    panel = { id = country_card style = country width = 238 tooltip = hud.tip.country children = {
                        row = { id = country_row gap = 8 children = {
                            module = { id = country_flag width = 86 module = dynamic_flag }
                            column = { id = country_stack grow = 1 gap = 0 children = {
                                label = { id = country_caption style = secondary height = 20 text = hud.country }
                                label = { id = country_value style = primary height = 30 text = { bind = country_name } }
                            } }
                        } }
                    } }
                    panel = { id = rank_card style = stat width = 110 tooltip = hud.tip.rank children = {
                        row = { id = rank_row gap = 8 children = {
                            image = { id = rank_icon style = medallion width = 40 icon = icon.rank }
                            column = { id = rank_stack grow = 1 gap = 0 children = {
                                label = { id = rank_value style = primary height = 28 text = { bind = rank } }
                                label = { id = rank_caption style = secondary height = 20 text = hud.rank }
                            } }
                        } }
                    } }
                    panel = { id = treasury_card style = stat width = 158 tooltip = hud.tip.treasury children = {
                        row = { id = treasury_row gap = 8 children = {
                            image = { id = treasury_icon style = medallion width = 40 icon = icon.treasury }
                            column = { id = treasury_stack grow = 1 gap = 0 children = {
                                label = { id = treasury_value style = primary height = 28 text = { bind = treasury } }
                                label = { id = treasury_caption style = secondary height = 20 text = hud.treasury }
                            } }
                        } }
                    } }
                    panel = { id = balance_card style = stat width = 162 tooltip = hud.tip.balance children = {
                        row = { id = balance_row gap = 8 children = {
                            image = { id = balance_icon style = medallion width = 40 icon = icon.balance }
                            column = { id = balance_stack grow = 1 gap = 0 children = {
                                label = { id = balance_value style = positive height = 28 text = { bind = balance } }
                                label = { id = balance_caption style = secondary height = 20 text = hud.balance }
                            } }
                        } }
                    } }
                    panel = { id = population_card style = stat width = 165 tooltip = hud.tip.population children = {
                        row = { id = population_row gap = 8 children = {
                            image = { id = population_icon style = medallion width = 40 icon = icon.population }
                            column = { id = population_stack grow = 1 gap = 0 children = {
                                label = { id = population_value style = primary height = 28 text = { bind = population } }
                                label = { id = population_caption style = secondary height = 20 text = hud.population }
                            } }
                        } }
                    } }
                    panel = { id = gdp_card style = stat width = 118 tooltip = hud.tip.gdp children = {
                        row = { id = gdp_row gap = 8 children = {
                            image = { id = gdp_icon style = medallion width = 40 icon = icon.gdp }
                            column = { id = gdp_stack grow = 1 gap = 0 children = {
                                label = { id = gdp_value style = primary height = 28 text = { bind = gdp } }
                                label = { id = gdp_caption style = secondary height = 20 text = hud.gdp }
                            } }
                        } }
                    } }
                    spacer = { id = top_spacer grow = 1 }
                    panel = { id = time_cluster style = time width = 320 tooltip = hud.tip.time children = {
                        row = { id = time_row gap = 8 children = {
                            image = { id = calendar_icon style = medallion width = 40 icon = icon.calendar }
                            column = { id = date_stack width = 104 gap = 0 children = {
                                label = { id = time_caption style = secondary height = 18 text = hud.time }
                                label = { id = date_value style = primary height = 30 text = { bind = date } }
                            } }
                            row = { id = speed_controls grow = 1 gap = 2 children = {
                                button = { id = pause_button style = time width = 22 text = hud.pause command = toggle_pause selected = { bind = paused_active } }
                                button = { id = speed_1 style = time width = 22 text = hud.speed.1 command = set_speed_1 selected = { bind = speed_1_active } }
                                button = { id = speed_2 style = time width = 22 text = hud.speed.2 command = set_speed_2 selected = { bind = speed_2_active } }
                                button = { id = speed_3 style = time width = 22 text = hud.speed.3 command = set_speed_3 selected = { bind = speed_3_active } }
                                button = { id = speed_4 style = time width = 22 text = hud.speed.4 command = set_speed_4 selected = { bind = speed_4_active } }
                                button = { id = speed_5 style = time width = 22 text = hud.speed.5 command = set_speed_5 selected = { bind = speed_5_active } }
                            } }
                        } }
                    } }
                } }
            } }

            stack = { id = viewport_stage grow = 1 children = {
            row = { id = main_workspace grow = 1 gap = 0 children = {
                panel = { id = navigation style = dock width = 66 children = {
                    column = { id = navigation_stack gap = 2 children = {
                        button = { id = nav_politics style = medallion height = 58 icon = icon.politics command = open_politics selected = { bind = politics_active } tooltip = hud.tip.politics }
                        button = { id = nav_buildings style = medallion height = 58 icon = icon.buildings command = open_buildings selected = { bind = buildings_active } tooltip = hud.tip.buildings }
                        button = { id = nav_market style = medallion height = 58 icon = icon.market command = open_market selected = { bind = market_active } tooltip = hud.tip.market }
                        button = { id = nav_economy style = medallion height = 58 icon = icon.economy command = open_economy selected = { bind = economy_active } tooltip = hud.tip.economy }
                        button = { id = nav_population style = medallion height = 58 icon = icon.population command = open_population selected = { bind = population_active } tooltip = hud.tip.population }
                        button = { id = nav_technology style = medallion height = 58 icon = icon.technology command = open_technology selected = { bind = technology_active } tooltip = hud.tip.technology }
                        button = { id = nav_military style = medallion height = 58 icon = icon.military command = open_military selected = { bind = military_active } tooltip = hud.tip.military }
                        button = { id = nav_diplomacy style = medallion height = 58 icon = icon.diplomacy command = open_diplomacy selected = { bind = diplomacy_active } tooltip = hud.tip.diplomacy }
                    } }
                } }

                stack = { id = page_drawer width = 390 visible = { bind = drawer_open } children = {
                    panel = { id = politics_page style = hud text = hud.page.politics visible = { bind = politics_active } children = {
                        column = { id = politics_column gap = 7 children = {
                            button = { id = government_card style = menu_row height = 68 icon = icon.politics text = hud.politics.government selected = yes tooltip = hud.tip.politics.government }
