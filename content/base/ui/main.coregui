# Grand Strategy HUD presentation. Gameplay data and commands stay in the
# game-owned provider; this file owns composition, icon roles and hierarchy.

ui_text hud.country        { en = "PLAYER NATION"      zh_cn = "玩家国家" }
ui_text hud.rank           { en = "RANK"              zh_cn = "排名" }
ui_text hud.treasury       { en = "TREASURY"          zh_cn = "国库" }
ui_text hud.balance        { en = "WEEKLY"            zh_cn = "每周结余" }
ui_text hud.population     { en = "POPULATION"        zh_cn = "人口" }
ui_text hud.gdp            { en = "GDP"               zh_cn = "国内生产总值" }
ui_text hud.time           { en = "NATIONAL TIME"     zh_cn = "国家时间" }

ui_text hud.tip.country    { en = "Player Nation|National identity and diplomatic status" zh_cn = "玩家国家|国家身份与外交地位" }
