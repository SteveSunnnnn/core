# Non-production component inspection surface. It is compiled with the HUD
# but never mounted by the game, allowing automated snapshots to compare all
# persistent interaction states in one stable layout.
scripted_gui component_showcase {
    context = hud
    root = {
        type = panel
        id = showcase_root
        style = wood
        width = 1180
        height = 720
        text = showcase.title
        children = {
            column = { id = showcase_columns gap = 14 children = {
                panel = { id = showcase_button_section style = section text = showcase.title height = 180 children = {
                    row = { id = showcase_button_states gap = 10 children = {
                        button = { id = showcase_normal style = section grow = 1 text = showcase.normal icon = icon.politics }
                        button = { id = showcase_hover style = section grow = 1 text = showcase.hover icon = icon.politics hovered = yes }
                        button = { id = showcase_pressed style = section grow = 1 text = showcase.pressed icon = icon.politics pressed = yes }
                        button = { id = showcase_selected style = section grow = 1 text = showcase.selected icon = icon.politics selected = yes }
                        button = { id = showcase_disabled style = section grow = 1 text = showcase.disabled icon = icon.politics enabled = no }
                        button = { id = showcase_focused style = section grow = 1 text = showcase.focused icon = icon.politics focused = yes }
                    } }
                } }
                panel = { id = showcase_medallion_section style = section text = hud.nav.politics height = 150 children = {
                    row = { id = showcase_medallion_states gap = 14 children = {
                        button = { id = medallion_normal style = medallion width = 70 icon = icon.politics }
                        button = { id = medallion_hover style = medallion width = 70 icon = icon.market hovered = yes }
                        button = { id = medallion_pressed style = medallion width = 70 icon = icon.economy pressed = yes }
                        button = { id = medallion_selected style = medallion width = 70 icon = icon.population selected = yes }
                        button = { id = medallion_disabled style = medallion width = 70 icon = icon.military enabled = no }
                    } }
                } }
                panel = { id = showcase_rows_section style = section text = hud.politics.government height = 220 children = {
                    column = { id = showcase_row_states gap = 4 children = {
                        button = { id = row_normal style = menu_row height = 52 text = showcase.normal icon = icon.rank }
