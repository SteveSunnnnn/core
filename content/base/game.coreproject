game_project base {
    start_date = 1836.01.01
    main_ui = ui/main.coregui
    # Legacy composed map kept as a compatibility fallback. The live renderer
    # uses the separate categorical/terrain/height layers below.
    world_map = map/world/world_map.coreimg
    world_map_ids = map/world/world_map_ids.coreimg
    world_map_terrain = map/world/world_map_terrain.coreimg
    world_map_height = map/world/world_map_height.coreimg
    world_map_political_lut = map/world/world_map_political_lut.coreimg
    world_location_index = map/world/world_locations.coremap
    world_boundary_vectors_near = map/world/world_boundaries_near.corevec
    world_boundary_vectors_medium = map/world/world_boundaries_medium.corevec
    world_boundary_vectors_far = map/world/world_boundaries_far.corevec
    default_language = en
}
