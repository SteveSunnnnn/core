#version 460
layout(location=0) in vec2 uv;layout(location=1) in vec4 color;layout(set=0,binding=0) uniform sampler2D atlas;layout(location=0) out vec4 outColor;layout(push_constant) uniform Push{float px_range;}pc;float median3(float r,float g,float b){return max(min(r,g),min(max(r,g),b));}void main(){vec3 s=texture(atlas,uv).rgb;float sd=median3(s.r,s.g,s.b)-0.5;float range=pc.px_range>0.0?pc.px_range:1.0;float a=clamp(sd*range/fwidth(sd)+0.5,0.0,1.0);outColor=vec4(color.rgb,color.a*a);}