{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "dev-headless",
      "displayName": "Core Dev Headless",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev-headless",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release-headless",
      "displayName": "Core Release Headless QA",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release-headless",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev-headless", "configurePreset": "dev-headless" },
    { "name": "release-headless", "configurePreset": "release-headless" }
  ]
}
